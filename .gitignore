# =========================================================================
# Root .gitignore for the SanKalp monorepo
#   MobileApp/              React Native app   (has its own .gitignore too)
#   Backend/auth-service/   Spring Boot API    (has its own .gitignore too)
# =========================================================================

# ---------------- Local-only docs (kept on disk, not pushed) ----------------
/ARCHITECTURE.md
/README.md

# ---------------- SECRETS: never commit ----------------
# Local backend secrets (Gmail app password, etc.). Template: secrets.example.properties
**/secrets.properties
**/*.secrets.properties
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
# Release signing keys. The shared debug.keystore is intentionally allowed (see MobileApp/.gitignore).
*.keystore
!**/debug.keystore
**/keystore.properties
**/google-services.json
**/GoogleService-Info.plist
**/client_secret*.json

# ---------------- IDE / workspace ----------------
# Eclipse workspace metadata (Backend/ is used as the Eclipse workspace)
Backend/.metadata/
.metadata/
.recommenders/
.classpath
.project
.settings/
.idea/
*.iml
.vscode/
*.code-workspace

# ---------------- Build output / dependencies ----------------
node_modules/
target/
build/
.gradle/
.kotlin/
*.log

# ---------------- OS ----------------
.DS_Store
Thumbs.db
desktop.ini
